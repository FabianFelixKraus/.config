      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a11_di" modelElement="a11" sourceElement="p2" targetElement="t_tauRD">
        <ptnDi:waypoint x="280" y="300" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="337" y="300" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a12_di" modelElement="a12" sourceElement="t_tauRD" targetElement="p_r1b">
        <ptnDi:waypoint x="383" y="290" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="452" y="258" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a13_di" modelElement="a13" sourceElement="t_tauRD" targetElement="p_d1b">
        <ptnDi:waypoint x="383" y="310" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="452" y="342" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a14_di" modelElement="a14" sourceElement="p_r1b" targetElement="t_res2">
        <ptnDi:waypoint x="488" y="250" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="557" y="250" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a15_di" modelElement="a15" sourceElement="t_res2" targetElement="p_r2b">
        <ptnDi:waypoint x="603" y="250" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="672" y="250" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a16_di" modelElement="a16" sourceElement="p_d1b" targetElement="t_del2">
        <ptnDi:waypoint x="488" y="350" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="557" y="350" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a17_di" modelElement="a17" sourceElement="t_del2" targetElement="p_d2b">
        <ptnDi:waypoint x="603" y="350" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="672" y="350" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a18_di" modelElement="a18" sourceElement="p_r2b" targetElement="t_sync">
        <ptnDi:waypoint x="708" y="258" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="777" y="290" xsi:type="dc:Point"/>
      </ptnDi:diagramEdge>
      <ptnDi:diagramEdge id="a19_di" modelElement="a19" sourceElement="p_d2b" targetElement="t_sync">
        <ptnDi:waypoint x="708" y="342" xsi:type="dc:Point"/>
        <ptnDi:waypoint x="777" y="310" xsi:type="dc:Point"/>
