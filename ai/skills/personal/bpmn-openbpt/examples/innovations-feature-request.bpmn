      <bpmndi:BPMNShape id="DOR_T_created_di" bpmnElement="DOR_T_created">
        <dc:Bounds x="352" y="290" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DOR_UI_created_di" bpmnElement="DOR_UI_created">
        <dc:Bounds x="487" y="455" width="36" height="50"/>
