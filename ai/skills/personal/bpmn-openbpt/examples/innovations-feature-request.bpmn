<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_inno" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Part_Customer" name="Customer"/>
    <bpmn:participant id="Part_Inno" name="Innovations GmbH" processRef="Process_Inno"/>
    <bpmn:messageFlow id="M1" sourceRef="Part_Customer" targetRef="Start_FR"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Inno" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PM" name="Product management">
        <bpmn:flowNodeRef>Start_FR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_UIchanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_UIinvolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Designer" name="Start-Up designer">
        <bpmn:flowNodeRef>Task_CreateUISpec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateUISpec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="Development team">
        <bpmn:flowNodeRef>GW_Backlog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Rank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Sprint</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DObj_Ticket"/>
    <bpmn:dataObject id="DObj_UISpec"/>
    <bpmn:dataObjectReference id="DOR_T_created" name="Ticket [created]" dataObjectRef="DObj_Ticket"/>
    <bpmn:dataObjectReference id="DOR_UI_created" name="UI specification [created]" dataObjectRef="DObj_UISpec"/>
    <bpmn:dataObjectReference id="DOR_T_impl" name="Ticket [implemented]" dataObjectRef="DObj_Ticket"/>
    <bpmn:dataObjectReference id="DOR_T_done" name="Ticket [done]" dataObjectRef="DObj_Ticket"/>
    <bpmn:startEvent id="Start_FR" name="Feature request received">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:task id="Task_CreateTicket" name="Create ticket">
      <bpmn:dataOutputAssociation id="DA1">
        <bpmn:targetRef>DOR_T_created</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_UIchanges" name="UI changes?" default="F4"/>
    <bpmn:task id="Task_UpdateTicket" name="Update ticket"/>
    <bpmn:exclusiveGateway id="GW_UIinvolved" name="UI involved?" default="F11"/>
    <bpmn:task id="Task_Review" name="Review ticket">
      <bpmn:dataOutputAssociation id="DA4">
        <bpmn:targetRef>DOR_T_done</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Approved" name="Requirements met?" default="F19"/>
    <bpmn:endEvent id="End_Done" name="Feature request implemented"/>
    <bpmn:task id="Task_CreateUISpec" name="Create UI specification">
      <bpmn:dataOutputAssociation id="DA2">
        <bpmn:targetRef>DOR_UI_created</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_UpdateUISpec" name="Update UI specification"/>
    <bpmn:exclusiveGateway id="GW_Backlog" name="Backlog"/>
    <bpmn:adHocSubProcess id="Sub_Rank" name="Rank ticket">
      <bpmn:task id="Task_Estimate" name="Estimate effort"/>
      <bpmn:task id="Task_Prioritize" name="Prioritize ticket"/>
      <bpmn:task id="Task_AddWork" name="Add technical work items"/>
    </bpmn:adHocSubProcess>
    <bpmn:exclusiveGateway id="GW_Clear" name="Ticket &amp; specs clear?" default="F13"/>
    <bpmn:exclusiveGateway id="GW_Planned" name="Ticket planned?" default="F14"/>
    <bpmn:subProcess id="Sub_Implement" name="Implement ticket">
      <bpmn:dataOutputAssociation id="DA3">
        <bpmn:targetRef>DOR_T_impl</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Sprint" name="End of sprint reached" attachedToRef="Sub_Implement" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_FR" targetRef="Task_CreateTicket"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CreateTicket" targetRef="GW_UIchanges"/>
    <bpmn:sequenceFlow id="F3" sourceRef="GW_UIchanges" targetRef="Task_CreateUISpec" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uiChanges</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="GW_UIchanges" targetRef="GW_Backlog" name="no"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_CreateUISpec" targetRef="GW_Backlog"/>
    <bpmn:sequenceFlow id="F6" sourceRef="GW_Backlog" targetRef="Sub_Rank"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Sub_Rank" targetRef="GW_Clear"/>
    <bpmn:sequenceFlow id="F8" sourceRef="GW_Clear" targetRef="Task_UpdateTicket" name="unclear">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">unclear</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_UpdateTicket" targetRef="GW_UIinvolved"/>
    <bpmn:sequenceFlow id="F10" sourceRef="GW_UIinvolved" targetRef="Task_UpdateUISpec" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">uiInvolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="GW_UIinvolved" targetRef="GW_Backlog" name="no"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_UpdateUISpec" targetRef="GW_Backlog"/>
    <bpmn:sequenceFlow id="F13" sourceRef="GW_Clear" targetRef="GW_Planned" name="clear"/>
    <bpmn:sequenceFlow id="F14" sourceRef="GW_Planned" targetRef="Sub_Implement" name="planned"/>
    <bpmn:sequenceFlow id="F15" sourceRef="GW_Planned" targetRef="GW_Backlog" name="not planned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notPlanned</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="Sub_Implement" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Boundary_Sprint" targetRef="GW_Backlog"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Review" targetRef="GW_Approved"/>
    <bpmn:sequenceFlow id="F19" sourceRef="GW_Approved" targetRef="End_Done" name="approved"/>
    <bpmn:sequenceFlow id="F20" sourceRef="GW_Approved" targetRef="GW_Backlog" name="rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Part_Customer_di" bpmnElement="Part_Customer" isHorizontal="true">
        <dc:Bounds x="190" y="70" width="1760" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Inno_di" bpmnElement="Part_Inno" isHorizontal="true">
