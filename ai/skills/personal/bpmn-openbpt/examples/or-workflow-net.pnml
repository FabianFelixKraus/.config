<?xml version="1.0" encoding="utf-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net_1" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>OR gateway - workflow net</text>
    </name>
    <page id="page1">
      <place id="p_i">
        <name>
          <text>i</text>
        </name>
        <graphics>
          <position x="78" y="300"/>
        </graphics>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <transition id="t_assess">
        <name>
          <text>Assess order</text>
        </name>
        <graphics>
          <position x="170" y="300"/>
        </graphics>
      </transition>
      <place id="p2">
        <name>
          <text>p2</text>
        </name>
        <graphics>
          <position x="262" y="300"/>
        </graphics>
      </place>
      <transition id="t_tauR">
        <name>
          <text>reserve only</text>
        </name>
        <graphics>
          <position x="360" y="150"/>
        </graphics>
      </transition>
      <place id="p_r1">
        <name>
          <text>reserve chosen</text>
        </name>
        <graphics>
          <position x="470" y="150"/>
        </graphics>
      </place>
      <transition id="t_res1">
        <name>
          <text>Reserve stock</text>
        </name>
        <graphics>
          <position x="580" y="150"/>
        </graphics>
      </transition>
      <transition id="t_tauD">
        <name>
          <text>deliver only</text>
        </name>
        <graphics>
          <position x="360" y="450"/>
        </graphics>
      </transition>
      <place id="p_d1">
        <name>
          <text>deliver chosen</text>
        </name>
        <graphics>
          <position x="470" y="450"/>
        </graphics>
      </place>
      <transition id="t_del1">
        <name>
          <text>Arrange delivery</text>
        </name>
        <graphics>
          <position x="580" y="450"/>
        </graphics>
      </transition>
      <transition id="t_tauRD">
        <name>
          <text>both (fork)</text>
        </name>
        <graphics>
          <position x="360" y="300"/>
        </graphics>
      </transition>
      <place id="p_r1b">
        <name>
          <text>reserve chosen</text>
        </name>
        <graphics>
          <position x="470" y="250"/>
        </graphics>
      </place>
      <place id="p_d1b">
        <name>
          <text>deliver chosen</text>
        </name>
        <graphics>
          <position x="470" y="350"/>
        </graphics>
      </place>
      <transition id="t_res2">
        <name>
          <text>Reserve stock</text>
        </name>
        <graphics>
          <position x="580" y="250"/>
        </graphics>
      </transition>
      <transition id="t_del2">
        <name>
          <text>Arrange delivery</text>
        </name>
        <graphics>
          <position x="580" y="350"/>
        </graphics>
      </transition>
      <place id="p_r2b">
        <name>
          <text>reserved</text>
        </name>
        <graphics>
          <position x="690" y="250"/>
        </graphics>
      </place>
      <place id="p_d2b">
        <name>
          <text>delivered</text>
        </name>
        <graphics>
          <position x="690" y="350"/>
        </graphics>
      </place>
      <transition id="t_sync">
        <name>
          <text>sync (join)</text>
        </name>
        <graphics>
          <position x="800" y="300"/>
        </graphics>
      </transition>
      <place id="p_pj">
        <name>
          <text>pj</text>
        </name>
        <graphics>
          <position x="900" y="300"/>
        </graphics>
      </place>
      <transition id="t_confirm">
        <name>
          <text>Confirm</text>
        </name>
        <graphics>
          <position x="992" y="300"/>
        </graphics>
      </transition>
      <place id="p_o">
        <name>
          <text>o</text>
        </name>
        <graphics>
          <position x="1084" y="300"/>
        </graphics>
      </place>
      <arc id="a1" source="p_i" target="t_assess"/>
      <arc id="a2" source="t_assess" target="p2"/>
      <arc id="a3" source="p2" target="t_tauR"/>
      <arc id="a4" source="t_tauR" target="p_r1"/>
      <arc id="a5" source="p_r1" target="t_res1"/>
      <arc id="a6" source="t_res1" target="p_pj"/>
      <arc id="a7" source="p2" target="t_tauD"/>
      <arc id="a8" source="t_tauD" target="p_d1"/>
      <arc id="a9" source="p_d1" target="t_del1"/>
      <arc id="a10" source="t_del1" target="p_pj"/>
      <arc id="a11" source="p2" target="t_tauRD"/>
      <arc id="a12" source="t_tauRD" target="p_r1b"/>
      <arc id="a13" source="t_tauRD" target="p_d1b"/>
      <arc id="a14" source="p_r1b" target="t_res2"/>
      <arc id="a15" source="t_res2" target="p_r2b"/>
      <arc id="a16" source="p_d1b" target="t_del2"/>
      <arc id="a17" source="t_del2" target="p_d2b"/>
      <arc id="a18" source="p_r2b" target="t_sync"/>
      <arc id="a19" source="p_d2b" target="t_sync"/>
      <arc id="a20" source="t_sync" target="p_pj"/>
      <arc id="a21" source="p_pj" target="t_confirm"/>
      <arc id="a22" source="t_confirm" target="p_o"/>
    </page>
  </net>
</pnml>
