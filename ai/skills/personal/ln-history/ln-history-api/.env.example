# ln-history-api tool config (copy to .env). Both are optional:
#   - URL defaults to https://api.ln-history.info (the public reverse-proxy endpoint)
#   - the key is only needed when the API's ApiKeyMiddleware:Enabled is true.
#     When unset, the tool falls back to the ApiKey in
#     ln-history-api/appsettings.Development.json (for a locally-run instance).
LN_HISTORY_API_URL=https://api.ln-history.info
LN_HISTORY_API_KEY=
