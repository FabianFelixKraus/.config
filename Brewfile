# Installed by setup.sh via `brew bundle --file=Brewfile`.
# Keep in sync with the Linux apt equivalents in setup.sh.

brew "eza"                     # ls/ll/la/tree replacement
brew "bat"                     # cat replacement
brew "starship"                # shell prompt
brew "fzf"                     # fuzzy history/file search
brew "zoxide"                  # smarter `cd`
brew "zsh-autosuggestions"     # ghost-text completion
brew "zsh-syntax-highlighting" # command syntax highlighting
brew "jq"                      # JSON parsing (used by cleanup.sh)
